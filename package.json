{
  "name": "stream-plugin-engine",
  "version": "0.5.0",
  "description": "Lightweight, cross-platform JavaScript/TypeScript plugin engine for a media/streaming application: sandboxed QuickJS plugins, engine-controlled HTTP with SSRF policy and enforced manifest domains, handle-based HTML/JSON parsing, per-plugin persistent storage and settings, multi-plugin fan-out, a verified plugin registry, and a normalized source-result pipeline with playback metadata.",
  "keywords": [
    "plugin",
    "engine",
    "streaming",
    "typescript",
    "sandbox",
    "quickjs",
    "wasm",
    "ssrf"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./manifest": {
      "types": "./dist/src/manifest.d.ts",
      "import": "./dist/src/manifest.js"
    },
    "./loader": {
      "types": "./dist/src/loader.d.ts",
      "import": "./dist/src/loader.js"
    },
    "./manager": {
      "types": "./dist/src/manager.d.ts",
      "import": "./dist/src/manager.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./http": {
      "types": "./dist/src/http.d.ts",
      "import": "./dist/src/http.js"
    },
    "./network": {
      "types": "./dist/src/network.d.ts",
      "import": "./dist/src/network.js"
    },
    "./phase5": {
      "types": "./dist/src/phase5.d.ts",
      "import": "./dist/src/phase5.js"
    },
    "./results": {
      "types": "./dist/src/results.d.ts",
      "import": "./dist/src/results.js"
    },
    "./package.json": "./package.json",
    "./coordinator": {
      "types": "./dist/src/coordinator.d.ts",
      "import": "./dist/src/coordinator.js"
    },
    "./store": {
      "types": "./dist/src/store.d.ts",
      "import": "./dist/src/store.js"
    },
    "./registry": {
      "types": "./dist/src/registry.d.ts",
      "import": "./dist/src/registry.js"
    }
  },
  "files": [
    "dist/src",
    "ARCHITECTURE.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/src/cli.js"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node tools/run-tests.mjs",
    "bench": "npm run build && node tools/benchmark.mjs",
    "plugins:list": "npm run build && node dist/src/cli.js",
    "plugin:run": "npm run build && node dist/src/cli.js run",
    "plugins:validate": "npm run build && node dist/src/cli.js validate"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^10.12.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "css-select": "^7.0.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "quickjs-emscripten": "^0.32.0"
  }
}
